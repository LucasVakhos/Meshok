{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "NewsWave": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/newswave-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NewsMaker": {
    "Program": {
      "RunDay": 7,
      "RunTime": "18:00:00"
    },
    "BridgeNote": {
      "Server": "",
      "Database": "",
      "UserID": "",
      "Password": "",
      "Port": 3306,
      "CharacterSet": "utf8",
      "ConnectionProtocol": "Tcp",
      "SslMode": "None"
    },
    "Post": {
      "Smtp": "",
      "User": "",
      "PassWrd": "",
      "BridgeEmail": "",
      "ContactPhone": "",
      "Port": 25,
      "UseSSL": true,
      "DeveloperEmail": ""
    },
    "SendLimit": 10,
    "ExportPath": "App_Data/exports"
  },
  "AllowedHosts": "*"
}
