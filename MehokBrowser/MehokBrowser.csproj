<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MehokBrowser</RootNamespace>
    <AssemblyName>MehokBrowser</AssemblyName>
    <ApplicationIcon>icons8_MaxCDN.ico</ApplicationIcon>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <!-- Prevent stale, untracked FluentNHibernate sources from reappearing in
         SDK-style builds after git pull. -->
    <Compile Remove="NewsMaker\**" />
    <Compile Remove="NHibernate\**\*.cs" />
    <EmbeddedResource Remove="NHibernate\**\*.resx" />
    <Compile Remove="Frames\SettingFrames\Main\**\*.cs" />
    <EmbeddedResource Remove="Frames\SettingFrames\Main\**\*.resx" />
    <None Remove="NewsMaker\**" />
    <Page Remove="NewsMaker\**" />
    <Compile Remove="Frames\SettingFrames\Main\MeshokSetting - Копировать.cs" />
    <Compile Remove="Frames\SettingFrames\Main\MeshokSetting - Копировать.Designer.cs" />
    <EmbeddedResource Remove="Frames\SettingFrames\Main\MeshokSetting - Копировать.resx" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Frames\SettingFrames\Main\Config\Cfg.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Win.Design" Version="25.2.7" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <DependentUpon>appsettings.json</DependentUpon>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\Forms\CfgFormIShop.resx">
      <DependentUpon>CfgFormIShop.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Configs\Frames\CfgFrameBridgeNote.resx">
      <DependentUpon>CfgFrameBridgenote.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Configs\Frames\CfgFrameCDUchet.resx">
      <DependentUpon>CfgFrameCDUchet.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Configs\Frames\CfgFrameIShop.resx">
      <DependentUpon>CfgFrameIShop.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Configs\Frames\CfgFrameMeshok.resx">
      <DependentUpon>CfgFrameMeshok.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Configs\Frames\LoginFrameIShop.resx">
      <DependentUpon>LoginFrameIShop.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Configs\Frames\MySqlConnectionFrame.resx">
      <DependentUpon>MySqlConnectionFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\AboutBox.resx">
      <DependentUpon>AboutBox.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\SplashScreen.resx">
      <DependentUpon>SplashScreen.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\SettingFrames\Main\Config\ConnectButton.resx" />
    <EmbeddedResource Include="Frames\SettingFrames\Main\Frames\ConfigBridgeFrame.resx" />
    <EmbeddedResource Include="Frames\SettingFrames\Main\Frames\ConfigIShopFrame.resx" />
    <EmbeddedResource Include="Frames\SettingFrames\Main\Frames\ConfigMeshokFrame.resx" />
    <EmbeddedResource Include="Workers\WorkWithLots\CreateCSV\BeginRelistLotsFrame.resx">
      <DependentUpon>BeginRelistLotsFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\SettingFrames\Main\MainConfigFrame.resx">
      <DependentUpon>MainConfigFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\WebFrames\MainWB.resx">
      <DependentUpon>MainWB.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\WebFrames\ProcessorWB.resx">
      <DependentUpon>ProcessorWB.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\ScanSettingFrames\BeginFrame.resx">
      <DependentUpon>BeginFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\ScanSettingFrames\ScanSettingLostDeals.resx">
      <DependentUpon>ScanSettingLostDeals.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\ScanSettingFrames\ScanSettingFrame.resx">
      <DependentUpon>ScanSettingFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\SettingFrames\SettingFrame.resx">
      <DependentUpon>SettingFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\TestBibbon.resx">
      <DependentUpon>TestBibbon.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\MainMeshok.resx">
      <DependentUpon>MainMeshok.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\ScanSettingFrames\ScanSettingClients.resx">
      <DependentUpon>ScanSettingClients.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\SettingFrames\Messages\SettingMessageesFrame.resx">
      <DependentUpon>SettingMessageesFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\WebFrames\ScanWebFrame.resx">
      <DependentUpon>ScanWebFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\WebFrames\InnerWB.resx">
      <DependentUpon>InnerWB.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\BaseForm.resx">
      <DependentUpon>BaseForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Frames\BaseFrame.resx">
      <DependentUpon>BaseFrame.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Content Include="icons8_MaxCDN.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LB.Libs\LB-Libs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
