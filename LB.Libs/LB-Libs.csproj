<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>LB.Libs</RootNamespace>
    <AssemblyName>LB-Libs</AssemblyName>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Win" Version="25.2.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <PackageReference Include="log4net" Version="3.3.1" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="DevExpress.Win.Design" Version="25.2.7" PrivateAssets="all" />
    <PackageReference Include="EventHook.Core.Temporary" Version="1.3.2" />
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\Secret.cs')">
    <Compile Include="..\Secret.cs" Link="Secret.cs" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Web.WebView2.Wpf.dll'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Remove="Legacy\Components\bin\**\*.cs" />
    <Compile Remove="Legacy\Components\obj\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Legacy\Components\ActionList\Images\Action.bmp" />
    <EmbeddedResource Include="Legacy\Components\ActionList\Images\ActionList.bmp" />
    <EmbeddedResource Include="Legacy\Components\Configs\Forms\CfgForm.resx">
      <DependentUpon>CfgForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Forms\CfgFormType.resx">
      <DependentUpon>CfgFormType.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\CfgBaseFrame.resx">
      <DependentUpon>CfgBaseFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\CfgConnectFrame.resx">
      <DependentUpon>CfgConnectFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\CfgConnectFrameType.resx">
      <DependentUpon>CfgConnectFrameType.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\CfgCoreFrame.resx">
      <DependentUpon>CfgCoreFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\CfgCoreFrameType.resx">
      <DependentUpon>CfgCoreFrameType.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\LoginFrame.resx">
      <DependentUpon>LoginFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\LoginFrameType.resx">
      <DependentUpon>LoginFrameType.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Configs\Frames\TestFrame.resx">
      <DependentUpon>TestFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Controls\ConnectButton.resx">
      <DependentUpon>ConnectButton.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Grids\GridHighLiteSetting.resx">
      <DependentUpon>GridHighLiteSetting.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\Images\ActionImages.resx">
      <DependentUpon>ActionImages.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\UserForms\AboutBox.resx">
      <DependentUpon>AboutBox.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\UserForms\SplashScreen.resx">
      <DependentUpon>SplashScreen.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\UserFrames\AbstractFrame.resx">
      <DependentUpon>AbstractFrame.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Legacy\Components\ActionList\ActionList.resx">
      <DependentUpon>ActionList.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
